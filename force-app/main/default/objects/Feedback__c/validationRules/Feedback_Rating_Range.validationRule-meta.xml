<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <description>The feedback rating is a score between 0 and 5.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Rating__c)), OR(Rating__c &lt; 0, Rating__c &gt; 5))</errorConditionFormula>
    <errorDisplayField>Feedback__c.Rating__c</errorDisplayField>
    <errorMessage>The rating must be a score between 0 and 5.</errorMessage>
    <fullName>Feedback_Rating_Range</fullName>
</ValidationRule>
