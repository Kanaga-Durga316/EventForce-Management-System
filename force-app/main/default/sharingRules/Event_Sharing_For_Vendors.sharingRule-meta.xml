<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <rules>
        <rule>
            <accessLevel>Read</accessLevel>
            <active>true</active>
            <criteria>Vendor_Contact_Email__c = $User.Email</criteria>
            <description>Vendors see read only the events they are responsible for. The vendor contact is identified by the Vendor Contact Email field of the event and the email address of the logged in user.</description>
            <fullName>Event_Sharing_For_Vendors</fullName>
            <object>Event__c</object>
            <sharedTo>
                <role>Vendor Manager</role>
            </sharedTo>
        </rule>
    </rules>
</SharingRules>
